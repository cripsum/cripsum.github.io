php_value session.gc_maxlifetime 1209600
php_value session.cookie_lifetime 1209600
php_value session.gc_probability 1
php_value session.gc_divisor 1000
php_flag display_errors Off
php_flag log_errors On
php_flag expose_php Off
php_value session.use_strict_mode 1
php_value session.use_only_cookies 1
php_value session.use_trans_sid 0
php_value session.name "__Host-cripsum_session"
php_value session.cookie_path "/"
php_value session.cookie_secure 1
php_value session.cookie_httponly 1
php_value session.cookie_samesite "Lax"

RewriteEngine On

# Never expose application secrets, local diagnostics, or browser-executable
# content uploaded by users.
RewriteRule ^(?:config|secure|migrations|scripts)(?:/|$) - [F,L,NC]
RewriteRule ^(?:scratch)(?:/|$) - [F,L,NC]
# The (?:/|$) tail matters: with "\.php$" alone these files still ran when
# requested as file.php/anything (PATH_INFO).
RewriteRule ^(?:debug_chars|test_apply)\.php(?:/|$) - [F,L,NC]
RewriteRule ^api/(?:bot/migrate_[^/]+|chat/(?:create_group_chat_db|debug_chat|fix_chat_db|temp_debug|test_list|test_messages)|game/(?:check_db_name|check_prod_db|debug_actions)|social/(?:init_db|debug_friends|debug_profile|migrate_[^/]+))\.php(?:/|$) - [F,L,NC]
RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml|html?|xhtml|svg|xml|js|mjs|htaccess)(?:[./]|$) - [F,L,NC]

# Personal data exports are served only by api/download_data_export.php, which
# checks the session. They must never be reachable by guessing a URL.
RewriteRule ^uploads/data_exports(?:/|$) - [F,L,NC]

# Avatar cache bookkeeping: the .json records hold absolute server paths.
# The thumbnails themselves stay reachable, only the metadata is blocked.
RewriteRule ^uploads/avatar_cache/meta(?:/|$) - [F,L,NC]

# File dei download caricati dal pannello: si scaricano solo da
# api/shop/download.php, che conta i download e fa avanzare le missioni.
RewriteRule ^uploads/downloads(?:/|$) - [F,L,NC]

# Copie su file delle immagini dei post: escono solo da api/content/media.php,
# che rispetta la scadenza e non le serve piu' se il post e' stato tolto.
RewriteRule ^uploads/content_cache(?:/|$) - [F,L,NC]

# Foto delle candidature per Chi siamo: le vede solo il pannello, da
# api/admin/chisiamo.php. Diventano pubbliche solo se la candidatura passa.
RewriteRule ^uploads/candidature(?:/|$) - [F,L,NC]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Manutenzione di emergenza. La manutenzione normale si accende dal pannello admin
# (Sito > Manutenzione): ha il motivo, l'elenco di chi puo' entrare e si spegne con un clic.
# Questo blocco serve solo quando PHP o il pannello non rispondono: togliendo i commenti
# tutto il sito risponde 503 con maintenance.html, una pagina ferma. Rimettili a lavoro finito.
# ErrorDocument 503 /maintenance.html
# RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
# RewriteCond %{REQUEST_URI} !^/favicon\.ico$ [NC]
# RewriteCond %{REQUEST_URI} !^/(assets|css|js|img|audio|vid)/ [NC]
# RewriteCond %{REQUEST_URI} !^/(it|en)/(accedi|admin|google_login|google_callback|animazione_personaggio)(\.php)?/?$ [NC]
# RewriteCond %{REQUEST_URI} !^/(auth|api/admin)/ [NC]
# RewriteCond %{REQUEST_URI} !^/api/(add_new_character_to_db|add_character_to_user|add_character_to_inventory|get_all_characters|get_character_from_id|get_character_from_nome|api_personaggi|api_get_characters_num)\.php$ [NC]
# RewriteCond %{REQUEST_URI} !^/logout\.php$ [NC]
# RewriteRule ^ - [R=503,L]

RewriteRule ^cripsumpedia/?$ cripsumpedia/index.php [L,QSA]
RewriteRule ^cripsumpedia/home/?$ cripsumpedia/index.php [L,QSA]
RewriteRule ^cripsumpedia/search/?$ cripsumpedia/search.php [L,QSA]
RewriteRule ^cripsumpedia/admin/?$ cripsumpedia/admin.php [L,QSA]
RewriteRule ^cripsumpedia/editor/?$ cripsumpedia/editor.php [L,QSA]
RewriteRule ^cripsumpedia/(persone|people|eventi|events|meme|memes)/?$ cripsumpedia/category.php?category=$1 [L,QSA]
RewriteRule ^cripsumpedia/(persone|people|eventi|events|meme|memes)/([a-zA-Z0-9_-]+)/?$ cripsumpedia/entry.php?category=$1&slug=$2 [L,QSA]
RewriteRule ^(it|en)/cripsumpedia/?$ cripsumpedia/index.php?lang=$1 [L,QSA]
RewriteRule ^(it|en)/cripsumpedia/home/?$ cripsumpedia/index.php?lang=$1 [L,QSA]
RewriteRule ^(it|en)/cripsumpedia/search/?$ cripsumpedia/search.php?lang=$1 [L,QSA]
RewriteRule ^(it|en)/cripsumpedia/admin/?$ cripsumpedia/admin.php?lang=$1 [L,QSA]
RewriteRule ^(it|en)/cripsumpedia/editor/?$ cripsumpedia/editor.php?lang=$1 [L,QSA]
RewriteRule ^(it|en)/cripsumpedia/(persone|people|eventi|events|meme|memes)/?$ cripsumpedia/category.php?lang=$1&category=$2 [L,QSA]
RewriteRule ^(it|en)/cripsumpedia/(persone|people|eventi|events|meme|memes)/([a-zA-Z0-9_-]+)/?$ cripsumpedia/entry.php?lang=$1&category=$2&slug=$3 [L,QSA]

# Rewind condivisi. Il token e' di 22 caratteri base64url: la regola non
# puo' collidere con gli alias personalizzati dei profili, che si fermano a 30
# caratteri ma non hanno mai una barra dopo "rewind".
RewriteRule ^rewind/([A-Za-z0-9_-]{22})/?$ rewind_public.php?token=$1 [L,QSA]
RewriteRule ^(it|en)/rewind/([A-Za-z0-9_-]{22})/?$ rewind_public.php?lang=$1&token=$2 [L,QSA]

# Shop: le collezioni del Merch e il dettaglio dei download stanno nel
# database, una pagina sola le disegna tutte.
RewriteRule ^(it|en)/merch/([a-z0-9-]{1,60})/([a-z0-9-]{1,80})/?$ $1/merch.php?collezione=$2&prodotto=$3 [L,QSA]
RewriteRule ^(it|en)/merch/([a-z0-9-]{1,60})/?$ $1/merch.php?collezione=$2 [L,QSA]
RewriteRule ^(it|en)/negozio/([a-z0-9-]{1,80})/?$ $1/negozio.php?prodotto=$2 [L,QSA]
RewriteRule ^(it|en)/download/([a-z0-9-]{1,80})/?$ $1/download.php?item=$2 [L,QSA]

# Team esports: la scheda di un player e' la pagina del team con quella
# scheda gia' aperta.
RewriteRule ^(it|en)/ohpy/([a-z0-9-]{1,60})/?$ $1/ohpy.php?player=$2 [L,QSA]

# Edits: /it/edits/28 e' la pagina degli edit con quell'edit gia' aperto.
RewriteRule ^(it|en)/edits/([0-9]{1,6})/?$ $1/edits.php?edit=$2 [L,QSA]

RewriteRule ^u/([a-zA-Z0-9_]{3,20})/?$ profile.php?username=$1 [L,QSA]

RewriteRule ^profile/([a-zA-Z0-9_]{3,20})/?$ profile.php?username=$1 [L,QSA]

RewriteRule ^it/u/([a-zA-Z0-9_]{3,20})/?$ profile.php?username=$1 [L,QSA]

RewriteRule ^user/([a-zA-Z0-9_]{3,20})/?$ profile.php?username=$1 [L,QSA]

RewriteRule ^it/game/?$ /it/game/lobby.php [L,QSA]
RewriteRule ^it/game/lobby/?$ /it/game/lobby.php [L,QSA]
RewriteRule ^it/game/arena/([0-9]+)/?$ /it/game/arena.php?match_id=$1 [L,QSA]


RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Redirect www to non-www and force HTTPS
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Force HTTPS for non-www (excluding localhost)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

AddDefaultCharset UTF-8

<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

RewriteRule ^user/([a-zA-Z0-9_]+)$ user.php?username=$1 [L,QSA]

# Custom Profile Alias Rule
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]{3,30})/?$ profile.php?custom_alias=$1 [L,QSA]

ErrorDocument 404 /404.php
